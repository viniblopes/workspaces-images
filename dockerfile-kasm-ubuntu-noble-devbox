ARG BASE_TAG="develop"
ARG BASE_IMAGE="core-ubuntu-noble"
FROM kasmweb/$BASE_IMAGE:$BASE_TAG
USER root

ENV HOME /home/kasm-default-profile
ENV STARTUPDIR /dockerstartup
WORKDIR $HOME

### Environment config
ENV DEBUG=false \
  DEBIAN_FRONTEND=noninteractive \
  KASM_RX_HOME=$STARTUPDIR/kasmrx \
  DONT_PROMPT_WSL_INSTALL="No_Prompt_please" \
  INST_DIR=$STARTUPDIR/install

# Install Mesa/OpenGL libraries for graphics support
RUN apt-get update --allow-releaseinfo-change || apt-get update && \
  apt-get install -y --no-install-recommends \
  mesa-utils \
  libgl1-mesa-dri \
  libgl1 \
  libegl1 \
  libgles2 \
  libnss3 \
  libatk1.0-0 \
  libatk-bridge2.0-0 \
  libcups2 \
  libdrm2 \
  libxkbcommon0 \
  libxcomposite1 \
  libxdamage1 \
  libxfixes3 \
  libxrandr2 \
  libgbm1 \
  libasound2t64 && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/*

# Disable core dumps system-wide (multiple layers for safety)
RUN echo "* soft core 0" >> /etc/security/limits.conf && \
  echo "* hard core 0" >> /etc/security/limits.conf && \
  echo "ulimit -c 0" >> /etc/profile.d/disable-coredumps.sh && \
  echo "session required pam_limits.so" >> /etc/pam.d/common-session && \
  # Disable apport (Ubuntu crash reporting)
  echo "enabled=0" > /etc/default/apport && \
  # Set core pattern to /dev/null as additional safety
  mkdir -p /etc/sysctl.d && \
  echo "kernel.core_pattern=/dev/null" > /etc/sysctl.d/50-coredump.conf && \
  echo "kernel.core_uses_pid=0" >> /etc/sysctl.d/50-coredump.conf && \
  echo "fs.suid_dumpable=0" >> /etc/sysctl.d/50-coredump.conf && \
  # Additional enforcement in bashrc and profile
  echo "ulimit -S -c 0 2>/dev/null || true" >> /etc/bash.bashrc && \
  echo "ulimit -S -c 0 2>/dev/null || true" >> /etc/profile


# Startup Scripts
COPY ./src/ubuntu/install/devbox/custom_startup.sh $STARTUPDIR/custom_startup.sh
RUN chmod 755 $STARTUPDIR/custom_startup.sh

COPY ./src/ubuntu/install/dind/custom_startup.sh $STARTUPDIR/dind_startup.sh
RUN chmod 755 $STARTUPDIR/dind_startup.sh

# Docker-in-Docker configuration
COPY ./src/ubuntu/install/dind/dockerd.conf /etc/supervisor/conf.d/
COPY ./src/ubuntu/install/dind/daemon.json /etc/docker/daemon.json

# --- INSTALLATION LAYERS ---

# 1. Dind
COPY ./src/ubuntu/install/dind/ $INST_DIR/ubuntu/install/dind/
RUN bash $INST_DIR/ubuntu/install/dind/install_dind.sh

# 2. Base Tools (Misc & Deluxe)
COPY ./src/ubuntu/install/misc/ $INST_DIR/ubuntu/install/misc/
RUN bash $INST_DIR/ubuntu/install/misc/install_tools.sh

# 2.1. Disable unnecessary services for CPU optimization
RUN bash $INST_DIR/ubuntu/install/misc/disable_services.sh

# 2.2. Optimize VNC quality to eliminate visual artifacts
RUN bash $INST_DIR/ubuntu/install/misc/optimize_vnc.sh

COPY ./src/ubuntu/install/tools/ $INST_DIR/ubuntu/install/tools/
RUN bash $INST_DIR/ubuntu/install/tools/install_tools_deluxe.sh

# 3. Browsers
COPY ./src/ubuntu/install/chrome/ $INST_DIR/ubuntu/install/chrome/
RUN bash $INST_DIR/ubuntu/install/chrome/install_chrome.sh

COPY ./src/ubuntu/install/chromium/ $INST_DIR/ubuntu/install/chromium/
RUN bash $INST_DIR/ubuntu/install/chromium/install_chromium.sh

# 4. Editors (Sublime, VS Code)
COPY ./src/ubuntu/install/sublime_text/ $INST_DIR/ubuntu/install/sublime_text/
RUN bash $INST_DIR/ubuntu/install/sublime_text/install_sublime_text.sh

COPY ./src/ubuntu/install/vs_code/ $INST_DIR/ubuntu/install/vs_code/
RUN bash $INST_DIR/ubuntu/install/vs_code/install_vs_code.sh

# 5. Development Tools
COPY ./src/ubuntu/install/dbeaver/ $INST_DIR/ubuntu/install/dbeaver/
RUN bash $INST_DIR/ubuntu/install/dbeaver/install_dbeaver.sh

COPY ./src/ubuntu/install/postman/ $INST_DIR/ubuntu/install/postman/
RUN bash $INST_DIR/ubuntu/install/postman/install_postman.sh

COPY ./src/ubuntu/install/gimp/ $INST_DIR/ubuntu/install/gimp/
RUN bash $INST_DIR/ubuntu/install/gimp/install_gimp.sh

COPY ./src/ubuntu/install/zoom/ $INST_DIR/ubuntu/install/zoom/
RUN bash $INST_DIR/ubuntu/install/zoom/install_zoom.sh

# 6. Frameworks (Flutter, FVM)
COPY ./src/ubuntu/install/flutter/ $INST_DIR/ubuntu/install/flutter/
RUN bash $INST_DIR/ubuntu/install/flutter/install_flutter.sh

COPY ./src/ubuntu/install/fvm/ $INST_DIR/ubuntu/install/fvm/
RUN bash $INST_DIR/ubuntu/install/fvm/install_fvm.sh

# 7. Redroid (Descomente para habilitar)
# COPY ./src/ubuntu/install/redroid/ $INST_DIR/ubuntu/install/redroid/
# RUN bash $INST_DIR/ubuntu/install/redroid/install_redroid.sh

# 8. Antigravity (Custom tool)
COPY ./src/ubuntu/install/antigravity/ $INST_DIR/ubuntu/install/antigravity/
RUN bash $INST_DIR/ubuntu/install/antigravity/install_antigravity.sh

# 9. Cleanup
COPY ./src/ubuntu/install/cleanup/ $INST_DIR/ubuntu/install/cleanup/
RUN bash $INST_DIR/ubuntu/install/cleanup/cleanup.sh

# Final Setup
RUN $STARTUPDIR/set_user_permission.sh $HOME && \
  rm -f /etc/X11/xinit/Xclients && \
  chown 1000:0 $HOME && \
  mkdir -p /home/kasm-user && \
  chown -R 1000:0 /home/kasm-user && \
  rm -Rf ${INST_DIR}

# Userspace Runtime
ENV HOME /home/kasm-user
WORKDIR $HOME
USER 1000

CMD ["--tail-log"]
